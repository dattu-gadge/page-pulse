PORT=5000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY=false
# For cross-site Vercel/Render hostnames use None; with app/api subdomains
# on the same registrable domain, Lax is preferable. Production always uses Secure cookies.
COOKIE_SAME_SITE=Lax

# Omit DATABASE_URL to use the local SQLite database at server/data/scans.sqlite.
# DATABASE_URL=postgresql://user:password@host:5432/pagepulse
# DATABASE_SSL is required for PostgreSQL. Use false only for a local database or
# Render's private/internal connection string. Use true for TLS; node-postgres
# verifies the server certificate against Node's trusted CAs.
# Do not include sslmode, sslcert, sslkey, or sslrootcert in DATABASE_URL.
DATABASE_SSL=false
# Optional path to the local SQLite database file.
# SCAN_STORE_PATH=./data/scans.sqlite
# Explicit source path required by `npm run import-sqlite`.
# SQLITE_IMPORT_SOURCE=./data/scans.sqlite
# Maximum graceful HTTP drain duration before active connections are closed.
SHUTDOWN_TIMEOUT_MS=10000
